---
import { Font } from "astro:assets";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title?: string;
    description?: string;
    // Absolute or site-relative URL to an OG/Twitter share image (1200x630
    // is the conventional size). For blog posts, pass the hero image's
    // optimized `src`.
    image?: string;
    // Use "article" for blog posts so social previews show the right card.
    ogType?: "website" | "article";
    publishedTime?: Date;
    // `frontmatter` is automatically passed by Markdown pages that use
    // `layout: ../layouts/Layout.astro` — we accept it as a fallback for
    // `title` (other meta is always passed explicitly from a wrapper).
    frontmatter?: { title?: string; description?: string };
}

const {
    title,
    description,
    image,
    ogType = "website",
    publishedTime,
    frontmatter,
} = Astro.props;

const SITE_NAME = "Caleb Sponheim";
const DEFAULT_DESCRIPTION =
    "Applied researcher and AI expert. Senior Experience Specialist and AI Lead at NN/G.";
// Site-wide fallback share card. The endpoint lives at
// `src/pages/og/site.png.ts` and renders at build time.
const DEFAULT_OG_IMAGE = "/og/site.png";

const pageTitle = title ?? frontmatter?.title ?? SITE_NAME;
const pageDescription =
    description ?? frontmatter?.description ?? DEFAULT_DESCRIPTION;
const shareImage = image ?? DEFAULT_OG_IMAGE;

// Canonical URL — built from the page's path and the site's `site` config.
// Falls back gracefully if `site` isn't set yet (dev environment).
const canonicalURL = Astro.site
    ? new URL(Astro.url.pathname, Astro.site).toString()
    : Astro.url.pathname;

// Resolve the share image to an absolute URL when we have a site config.
const absoluteImage = Astro.site
    ? new URL(shareImage, Astro.site).toString()
    : shareImage;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <Font cssVariable="--font-inter" preload />
        <Font cssVariable="--font-newsreader" preload />

        <!-- Primary SEO -->
        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />
        <link rel="canonical" href={canonicalURL} />

        <!-- Open Graph (Facebook, LinkedIn, Slack, Discord, iMessage…) -->
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:url" content={canonicalURL} />
        {absoluteImage && <meta property="og:image" content={absoluteImage} />}
        {
            publishedTime && (
                <meta
                    property="article:published_time"
                    content={publishedTime.toISOString()}
                />
            )
        }

        <!-- Twitter / X card -->
        <meta
            name="twitter:card"
            content={absoluteImage ? "summary_large_image" : "summary"}
        />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={pageDescription} />
        {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}

        <!-- RSS auto-discovery: feed readers and browsers find the feed -->
        <link
            rel="alternate"
            type="application/rss+xml"
            title={`${SITE_NAME} — Blog`}
            href="/rss.xml"
        />
    </head>
    <body>
        <Header />
        <main>
            <slot />
        </main>
        <Footer />
    </body>
</html>
