---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import portrait from "../assets/portrait.webp";
// Home page prose lives in Markdown rather than in this component so the copy
// can be edited (or edited through a Git-based CMS) without touching JSX.
// `src/copy/` sits outside `src/pages/`, so it never becomes a route.
import * as homepageCopy from "../copy/home.md";

const RESUME_URL = "/resume/caleb-sponheim-resume.pdf";
const EMAIL = "caleb.sponheim@gmail.com";

const {
    availability,
    featuredSlug,
    featuredEyebrow,
    featuredBlurb,
} = homepageCopy.frontmatter;

// Same draft filter as every other view of these collections — drafts show
// in dev, are hidden at build.
const recentPosts = (
    await getCollection("blog", ({ data }) => {
        return import.meta.env.DEV || !data.draft;
    })
)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);

// Projects keep their curated `order` here — the home page shows the top of
// that list, which is the point of hand-setting it.
const allProjects = (
    await getCollection("projects", ({ data }) => {
        return import.meta.env.DEV || !data.draft;
    })
).sort((a, b) => a.data.order - b.data.order);

// The featured project gets its own pitch above the list, so drop it from the
// list to avoid showing the same entry twice.
const featured = allProjects.find((entry) => entry.id === featuredSlug) ?? null;
const listedProjects = allProjects
    .filter((entry) => entry.id !== featured?.id)
    .slice(0, 4);

const dateFormatter = new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
});
---

<Layout
    title="Caleb Sponheim — Applied AI & UX Leader"
    description="Caleb Sponheim leads applied AI and UX work that turns emerging technology into useful, trustworthy products, operational systems, and training."
>
    <div class="home">
        <Image
            src={portrait}
            alt="Portrait of Caleb Sponheim"
            widths={[200, 400, 600]}
            sizes="(min-width: 720px) 224px, 88px"
            class="portrait"
        />

        <div class="content">
            <h1>Caleb Sponheim, PhD</h1>

            <div class="proposition">
                <homepageCopy.Content />
            </div>

            <p class="actions">
                <a class="button" href={RESUME_URL} download>
                    Download résumé <span class="button-hint">(PDF)</span>
                </a>
            </p>
        </div>
    </div>

    {
        featured && (
            <aside class="featured" aria-labelledby="featured-title">
                <p class="eyebrow">{featuredEyebrow}</p>
                <h2 id="featured-title">{featured.data.title}</h2>
                <p>{featuredBlurb}</p>
                <p class="featured-link">
                    <a href={`/projects/${featured.id}/`}>
                        Read the case study <span aria-hidden="true">→</span>
                    </a>
                </p>
            </aside>
        )
    }

    {
        recentPosts.length > 0 && (
            <section class="panel" aria-labelledby="recent-writing">
                <div class="panel-head">
                    <h2 id="recent-writing">Recent writing</h2>
                    <a class="panel-more" href="/blog">
                        All posts <span aria-hidden="true">→</span>
                    </a>
                </div>
                <ul class="teaser-list">
                    {recentPosts.map((post) => (
                        <li>
                            <a class="teaser" href={`/blog/${post.id}/`}>
                                <span class="teaser-title">
                                    {post.data.title}
                                </span>
                                <time
                                    class="teaser-meta"
                                    datetime={post.data.pubDate.toISOString()}
                                >
                                    {dateFormatter.format(post.data.pubDate)}
                                </time>
                            </a>
                            {post.data.description && (
                                <p class="teaser-description">
                                    {post.data.description}
                                </p>
                            )}
                        </li>
                    ))}
                </ul>
            </section>
        )
    }

    {
        listedProjects.length > 0 && (
            <section class="panel" aria-labelledby="selected-work">
                <div class="panel-head">
                    <h2 id="selected-work">Selected work</h2>
                    <a class="panel-more" href="/projects">
                        All projects <span aria-hidden="true">→</span>
                    </a>
                </div>
                <ul class="teaser-list">
                    {listedProjects.map((project) => {
                        const isExternal = Boolean(project.data.externalUrl);
                        return (
                            <li>
                                <a
                                    class="teaser"
                                    href={
                                        isExternal
                                            ? project.data.externalUrl
                                            : `/projects/${project.id}/`
                                    }
                                    {...(isExternal
                                        ? {
                                              target: "_blank",
                                              rel: "noopener noreferrer",
                                          }
                                        : {})}
                                >
                                    <span class="teaser-title">
                                        {project.data.title}
                                        {isExternal && (
                                            <>
                                                <span
                                                    class="external-icon"
                                                    aria-hidden="true"
                                                >
                                                    {" ↗"}
                                                </span>
                                                <span class="visually-hidden">
                                                    {" "}
                                                    (opens in a new tab)
                                                </span>
                                            </>
                                        )}
                                    </span>
                                    {project.data.dateLabel && (
                                        <span class="teaser-meta">
                                            {project.data.dateLabel}
                                        </span>
                                    )}
                                </a>
                                {project.data.description && (
                                    <p class="teaser-description">
                                        {project.data.description}
                                    </p>
                                )}
                            </li>
                        );
                    })}
                </ul>
            </section>
        )
    }

    <section class="contact" aria-labelledby="get-in-touch">
        <h2 id="get-in-touch">Want to get in touch?</h2>
        {availability && <p class="availability">{availability}</p>}
        <p>
            Email me at <a href={`mailto:${EMAIL}`}>{EMAIL}</a>. I will respond
            to messages that are a good match for my schedule and interests.
            Thanks!
        </p>
    </section>
</Layout>

<style>
    /* Single column on narrow screens: putting the portrait in its own
       column here squeezed the heading onto three lines and the prose to
       ~28 characters. It stacks above the text instead. */
    .home {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        grid-template-areas:
            "portrait"
            "content";
        gap: 1.25rem;
        align-items: start;
    }

    @media (min-width: 720px) {
        .home {
            grid-template-columns: minmax(0, 1fr) 14rem;
            grid-template-areas: "content portrait";
            column-gap: 3rem;
        }
    }

    /* The portrait used to be `display: none` below 720px, so the most-used
       viewport never saw the face on a personal site. Keeping it displayed at
       every width also fixes the old bug where the hidden grid item collapsed
       its row but kept the 2rem `row-gap`, leaving 32px of phantom space
       above the h1. */
    .portrait {
        grid-area: portrait;
        width: 5.5rem;
        height: 5.5rem;
        object-fit: cover;
        border-radius: 999px;
    }

    @media (min-width: 720px) {
        .portrait {
            width: 12rem;
            height: auto;
            border-radius: 0;
            object-fit: fill;
            justify-self: center;
        }
    }

    .content {
        grid-area: content;
    }

    /* --- Positioning statement --- */

    /* The lede runs large and serif; the credential bullets drop to sans at
       UI scale so they read as supporting evidence, not more prose. */
    .proposition {
        font-family: var(--font-serif);
        font-size: clamp(1.35rem, 2.5vw, 1.75rem);
        line-height: 1.35;
        max-width: var(--prose-width);
    }

    .proposition :global(p) {
        margin-bottom: 1.5rem;
    }

    .proposition :global(ul) {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.45rem 1.25rem;
        color: var(--color-text-muted);
        font-family: var(--font-sans);
        font-size: 0.9rem;
        line-height: 1.6;
    }

    @media (max-width: 520px) {
        .proposition :global(ul) {
            grid-template-columns: 1fr;
        }
    }

    .proposition :global(ul li) {
        position: relative;
        padding-left: 0.8rem;
    }

    /* Custom dot marker — `list-style: none` above drops the default so the
       two-column grid can control alignment. */
    .proposition :global(ul li::before) {
        content: "";
        position: absolute;
        left: 0;
        top: 0.65em;
        width: 0.25rem;
        height: 0.25rem;
        border-radius: 50%;
        background: var(--color-link);
    }

    .actions {
        margin: 1.75rem 0 0;
    }

    .button {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        min-height: 44px;
        padding: 0 1.125rem;
        border-radius: 0.5rem;
        background: var(--color-link);
        color: var(--color-bg);
        font-weight: 500;
        text-decoration: none;
    }

    .button:hover {
        /* Darken via the text color rather than a second brand token —
           keeps the palette to one accent. */
        background: var(--color-text);
    }

    .button-hint {
        font-weight: 400;
        opacity: 0.8;
        font-size: 0.9em;
    }

    /* --- Featured project --- */

    .featured {
        margin-top: 3.5rem;
        padding: 1.25rem 1.5rem;
        border: 1px solid var(--color-border);
        /* Accent rule on the leading edge marks this as the one promoted
           item without needing a filled background. */
        border-left: 3px solid var(--color-link);
        border-radius: 0 0.5rem 0.5rem 0;
        max-width: var(--prose-width);
    }

    .eyebrow {
        margin: 0 0 0.25rem;
        color: var(--color-text-muted);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .featured h2 {
        font-family: var(--font-serif);
        font-size: 1.4rem;
        font-weight: 500;
        margin: 0 0 0.35rem;
    }

    .featured p {
        margin: 0 0 0.65rem;
    }

    .featured-link {
        margin: 0;
    }

    /* --- Recent writing / Selected work --- */

    .panel {
        margin-top: 3.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
    }

    .panel-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem 1.5rem;
    }

    .panel-head h2 {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 600;
        letter-spacing: 0.01em;
    }

    .panel-more {
        font-size: 0.9rem;
        text-decoration: none;
    }

    .panel-more:hover {
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .teaser-list {
        list-style: none;
        padding: 0;
        margin: 1.25rem 0 0;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    /* Title and date share a baseline row; the description tucks beneath in
       the title's column. Same shape as the /projects rows so the two pages
       feel like one system. */
    .teaser {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        column-gap: 1.5rem;
        align-items: baseline;
        text-decoration: none;
        color: inherit;
    }

    .teaser-title {
        color: var(--color-link);
        font-weight: 500;
    }

    .teaser:hover .teaser-title {
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .teaser-meta {
        color: var(--color-text-muted);
        font-size: 0.85rem;
        white-space: nowrap;
    }

    .teaser-description {
        margin: 0.25rem 0 0;
        color: var(--color-text-muted);
        font-size: 0.9rem;
        line-height: 1.5;
        max-width: var(--prose-width);
    }

    .external-icon {
        font-weight: 400;
        font-size: 0.85em;
        opacity: 0.7;
    }

    /* --- Contact --- */

    .contact {
        margin-top: 3.5rem;
        padding: 1.5rem;
        background: var(--color-surface);
        border-radius: 0.75rem;
        max-width: var(--prose-width);
    }

    .contact h2 {
        margin: 0 0 0.5rem;
        font-size: 1.05rem;
        font-weight: 600;
    }

    .availability {
        margin: 0 0 0.75rem;
        color: var(--color-text-muted);
        font-size: 0.95rem;
    }

    .contact p:last-child {
        margin: 0;
    }
</style>
