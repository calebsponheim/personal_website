---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import portrait from "../assets/portrait.webp";
---

<Layout title="Caleb Sponheim">
    <div class="home">
        <Image
            src={portrait}
            alt="Portrait of Caleb Sponheim"
            widths={[200, 400, 600]}
            sizes="(min-width: 720px) 224px, 60vw"
            class="portrait"
        />

        <div class="content">
            <h1>Caleb Sponheim, PhD</h1>

            <p>
                I am an applied researcher and AI expert. Right now, I'm a
                Senior Experience Specialist and AI Lead at{" "}
                <a href="https://www.nngroup.com/people/caleb-sponheim/">NN/G</a
                >.
            </p>

            <p>
                I've been cited as an expert on AI in publications including{" "}
                <a href="https://time.com/7346052/problem-ai-flattering-us/"
                    >Time</a
                >,{" "}
                <a
                    href="https://www.axios.com/2025/07/07/ai-sycophancy-chatbots-mental-health"
                    >Axios</a
                >,{" "}
                <a href="https://futurism.com/sycophancy-chatbots-ai-problem"
                    >Futurism</a
                >, and{" "}
                <a
                    href="https://www.cnet.com/tech/services-and-software/apples-genmoji-might-be-a-prompt-engineering-training-tool-in-disguise/"
                    >CNET</a
                >.
            </p>

            <p class="contact">
                <strong>Want to get in touch?</strong>
                If you have an opportunity or introduction, shoot me a line at{" "}
                <em>caleb [dot] sponheim [at] gmail.com</em>. I will respond to
                messages that are a good match for my schedule and interests.
                Thanks!
            </p>

            <p>
                <a
                    class="cta"
                    href="https://docs.google.com/document/d/1rlU65uZEFFuvl20uaJZzaqjlPQYRzaJCtwfJ5-daZaM/edit?usp=sharing"
                >
                    See Caleb's Resume →
                </a>
            </p>
        </div>
    </div>
</Layout>

<style>
    .home {
        display: grid;
        grid-template-columns: 1fr;
        grid-template-areas:
            "portrait"
            "content";
        gap: 2rem;
    }

    @media (min-width: 720px) {
        .home {
            grid-template-columns: minmax(0, 1fr) 14rem;
            grid-template-areas: "content portrait";
            gap: 3rem;
            align-items: start;
        }
    }

    .portrait {
        display: none;
    }

    @media (min-width: 720px) {
        .portrait {
            display: block;
            grid-area: portrait;
            width: 12rem;
            height: auto;
            justify-self: center;
        }
    }

    .content {
        grid-area: content;
    }

    .contact strong {
        display: block;
        margin-bottom: 0.25rem;
    }

    .cta {
        display: inline-block;
        margin-top: 0.5rem;
        font-weight: 600;
        text-decoration: none;
        border-bottom: 1px solid currentColor;
    }
</style>
