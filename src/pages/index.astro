---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import portrait from "../assets/portrait.webp";
// Home page prose lives in Markdown rather than in this component so the copy
// can be edited (or edited through a Git-based CMS) without touching JSX.
// `src/copy/` sits outside `src/pages/`, so it never becomes a route.
import * as homepageCopy from "../copy/home.md";

const RESUME_URL = "/resume/caleb-sponheim-resume.pdf";
const EMAIL = "caleb.sponheim@gmail.com";

const { availability } = homepageCopy.frontmatter;
---

<Layout
    title="Caleb Sponheim | AI Research, Experiments, and Teaching"
    description="Caleb Sponheim investigates emerging AI and turns what he learns into experiments, practical frameworks, and teaching at NN/G."
>
    <div class="home">
        <Image
            src={portrait}
            alt="Portrait of Caleb Sponheim"
            widths={[200, 400, 600]}
            sizes="(min-width: 720px) 192px, 88px"
            class="portrait"
        />

        <div class="content">
            <h1>Caleb Sponheim, PhD</h1>

            <div class="proposition">
                <homepageCopy.Content />
            </div>

            <p class="actions">
                <a href={RESUME_URL}>See Caleb's resume</a>
            </p>
        </div>
    </div>

    <section class="contact" aria-labelledby="get-in-touch">
        <h2 id="get-in-touch">Get in touch</h2>
        {availability && <p class="availability">{availability}</p>}
        <p>
            <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </p>
    </section>
</Layout>

<style>
    .home {
        display: grid;
        gap: 1rem;
        align-items: start;
    }

    .portrait {
        width: 5.5rem;
        height: 5.5rem;
        object-fit: cover;
        border-radius: 50%;
    }

    @media (min-width: 720px) {
        .home {
            grid-template-columns: minmax(0, 1fr) 12rem;
            grid-template-areas: "content portrait";
            gap: 3rem;
        }

        .content {
            grid-area: content;
        }

        .portrait {
            grid-area: portrait;
            width: 100%;
            height: auto;
            border-radius: 0;
        }
    }

    h1 {
        font-size: clamp(1.875rem, 4vw, 2.5rem);
        margin-bottom: 1rem;
    }

    .proposition {
        max-width: var(--prose-width);
        font-size: 1.125rem;
    }

    .actions {
        margin: 0;
    }

    .actions a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
    }

    .contact {
        max-width: var(--prose-width);
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
    }

    .contact h2 {
        margin: 0 0 0.5rem;
        font-size: 1.25rem;
        font-weight: 600;
    }

    .contact p {
        margin: 0 0 0.75rem;
    }

    .contact p:last-child {
        margin: 0;
    }

    .contact a {
        overflow-wrap: anywhere;
    }
</style>
