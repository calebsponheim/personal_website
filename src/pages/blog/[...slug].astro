---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { tagSlug } from "../../utils/tags";

// Pre-render one static page per blog post at build time. `[...slug]`
// is a rest route, so the same file would also handle nested folders
// like `src/content/blog/2026/post.md` → `/blog/2026/post`.
export async function getStaticPaths() {
    const posts = await getCollection("blog", ({ data }) => {
        return import.meta.env.DEV || !data.draft;
    });
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

type Props = { post: CollectionEntry<"blog"> };
const { post } = Astro.props;

// `render()` returns a `<Content />` component that emits the parsed
// Markdown body, plus useful metadata (headings list, etc.) we could
// use for a table of contents later.
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
});

// Reading time from raw markdown body. ~225 wpm is the convention.
const words = (post.body ?? "").split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 225));
---

<Layout
    title={`${post.data.title} · Caleb Sponheim`}
    description={post.data.description}
    image={post.data.heroImage?.src ?? `/og/${post.id}.png`}
    ogType="article"
    publishedTime={post.data.pubDate}
>
    <article>
        <header class="post-header">
            <h1>{post.data.title}</h1>
            {
                post.data.description && (
                    <p class="post-lede">{post.data.description}</p>
                )
            }
            <p class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                    {dateFormatter.format(post.data.pubDate)}
                </time>
                {post.data.author && <span>· by {post.data.author}</span>}
                <span>· {readingMinutes} min read</span>
            </p>
            {
                post.data.canonicalUrl && (
                    <p class="canonical-note">
                        Originally published at{" "}
                        <a
                            href={post.data.canonicalUrl}
                            rel="canonical noopener"
                        >
                            {new URL(post.data.canonicalUrl).hostname}
                        </a>
                        .
                    </p>
                )
            }
            {
                post.data.heroImage && (
                    <Image
                        src={post.data.heroImage}
                        alt={post.data.heroImageAlt ?? ""}
                        widths={[400, 800, 1200, 1600]}
                        sizes="(min-width: 720px) 720px, 100vw"
                        class="post-hero"
                    />
                )
            }
        </header>
        <div class="post-body">
            <Content />
        </div>
        <footer class="post-footer">
            {
                post.data.tags && post.data.tags.length > 0 && (
                    <ul class="post-tags">
                        {post.data.tags.map((tag) => (
                            <li>
                                <a href={`/tags/${tagSlug(tag)}/`}>#{tag}</a>
                            </li>
                        ))}
                    </ul>
                )
            }
            <p class="back-link">
                <a href="/blog">← Back to all posts</a>
            </p>
        </footer>
    </article>
</Layout>

<style>
    article {
        max-width: 38rem;
        margin: 0 auto;
    }

    .post-header {
        margin-bottom: 2.5rem;
    }

    .post-lede {
        margin: 0.5rem 0 1rem;
        font-size: 1.25rem;
        line-height: 1.4;
        color: var(--color-text-muted);
    }

    .post-meta {
        margin: 0 0 1.5rem;
        color: var(--color-text-muted);
        font-size: 0.9rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .canonical-note {
        margin: 0 0 1.5rem;
        padding: 0.75rem 1rem;
        background: #f5f5f5;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        color: var(--color-text-muted);
    }

    .post-hero {
        width: 100%;
        height: auto;
        border-radius: 0.5rem;
        margin: 1.5rem 0 0;
    }

    /* Long-form reading typography. `:global()` is needed because the
       Markdown-rendered HTML inside <Content /> isn't scoped by Astro.
       Body switches to Newsreader (soft serif) for prose comfort while
       Inter remains in charge of headings, captions, and UI elements. */
    .post-body {
        font-family: var(--font-serif);
        font-size: 1.125rem;
        line-height: 1.7;
    }

    .post-body :global(h2) {
        font-size: 1.5rem;
        margin: 2.5rem 0 1rem;
        letter-spacing: -0.01em;
    }

    .post-body :global(h3) {
        font-size: 1.2rem;
        margin: 2rem 0 0.75rem;
    }

    .post-body :global(p) {
        margin: 0 0 1.25rem;
    }

    .post-body :global(blockquote) {
        margin: 1.5rem 0;
        padding: 0.5rem 1.25rem;
        border-left: 3px solid var(--color-border);
        color: var(--color-text-muted);
        font-style: italic;
    }

    .post-body :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: 0.5rem;
        margin: 1.5rem 0;
    }

    .post-body :global(figure) {
        margin: 2rem 0;
    }

    .post-body :global(figure img) {
        margin: 0;
    }

    .post-body :global(figcaption) {
        font-size: 0.875rem;
        line-height: 1.5;
        font-style: italic;
        color: var(--color-text-muted);
        text-align: center;
        margin: 0.75rem auto 0;
        max-width: 32rem;
    }

    .post-body :global(ul),
    .post-body :global(ol) {
        margin: 0 0 1.25rem;
        padding-left: 1.5rem;
    }

    .post-body :global(li) {
        margin-bottom: 0.5rem;
    }

    .post-body :global(code) {
        background: #f5f5f5;
        padding: 0.125rem 0.375rem;
        border-radius: 0.25rem;
        font-size: 0.95em;
    }

    .post-body :global(pre) {
        background: #f5f5f5;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        margin: 1.5rem 0;
    }

    .post-body :global(pre code) {
        background: none;
        padding: 0;
    }

    .post-body :global(hr) {
        margin: 2.5rem auto;
        border: none;
        border-top: 1px solid var(--color-border);
        width: 30%;
    }

    .post-footer {
        margin-top: 4rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
    }

    .post-tags {
        list-style: none;
        padding: 0;
        margin: 0 0 1.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .post-tags a {
        display: inline-block;
        padding: 0.25rem 0.625rem;
        background: #f5f5f5;
        border-radius: 999px;
        color: var(--color-text-muted);
        text-decoration: none;
        font-size: 0.85rem;
    }

    .post-tags a:hover {
        background: #ebebeb;
        color: var(--color-text);
    }

    .back-link {
        margin: 0;
    }
</style>
