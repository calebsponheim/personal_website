---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

// Fetch every entry in the `projects` collection. Drafts show in dev
// (so works-in-progress are previewable) but are hidden in production —
// same convention as the `blog` collection.
const projects = (
    await getCollection("projects", ({ data }) => {
        return import.meta.env.DEV || !data.draft;
    })
).sort((a, b) => a.data.order - b.data.order);

// Stand-in "end year" for work that hasn't ended. Sorting newest-first has
// to rank ongoing projects above anything already finished, and a sentinel
// keeps the comparators to plain number math on both server and client.
const ONGOING = 9999;

const SORTS = [
    { value: "relevance", label: "Relevance" },
    { value: "newest", label: "Date (newest first)" },
    { value: "oldest", label: "Date (oldest first)" },
];
---

<Layout
    title="Projects · Caleb Sponheim"
    description="Things I've built, written, taught, and made."
>
    <h1>Projects</h1>

    <p class="lede">
        This is a small subset of my work. See my <a
            href="https://docs.google.com/document/d/1rlU65uZEFFuvl20uaJZzaqjlPQYRzaJCtwfJ5-daZaM/edit?usp=sharing"
            >resume</a
        > for a more complete view.
    </p>

    {
        projects.length === 0 ? (
            <p>Projects coming soon.</p>
        ) : (
            <>
                {/* Hidden until the script runs — a sort control that can't
                    sort is worse than no control at all. */}
                <div class="sort-bar" data-sort-bar hidden>
                    <label for="project-sort">Sort by</label>
                    <select id="project-sort" data-sort-control>
                        {SORTS.map((sort) => (
                            <option value={sort.value}>{sort.label}</option>
                        ))}
                    </select>
                </div>

                <p
                    class="visually-hidden"
                    role="status"
                    aria-live="polite"
                    data-sort-status
                />

                <ul class="project-list" data-project-list>
                    {projects.map((project) => {
                        const isExternal = Boolean(project.data.externalUrl);
                        const href = isExternal
                            ? project.data.externalUrl
                            : `/projects/${project.id}/`;
                        const linkProps = isExternal
                            ? {
                                  target: "_blank",
                                  rel: "noopener noreferrer",
                              }
                            : {};
                        return (
                            <li
                                class="project-item"
                                data-order={project.data.order}
                                data-start={
                                    project.data.startYear ??
                                    project.data.endYear ??
                                    ONGOING
                                }
                                data-end={project.data.endYear ?? ONGOING}
                            >
                                <a
                                    href={href}
                                    class="project-link"
                                    {...linkProps}
                                >
                                    <h2 class="project-title">
                                        {project.data.title}
                                        {isExternal && (
                                            <>
                                                <span
                                                    class="external-icon"
                                                    aria-hidden="true"
                                                >
                                                    {" ↗"}
                                                </span>
                                                <span class="visually-hidden">
                                                    {" "}
                                                    (opens in a new tab)
                                                </span>
                                            </>
                                        )}
                                    </h2>
                                    {project.data.dateLabel && (
                                        <span class="project-meta">
                                            {project.data.dateLabel}
                                        </span>
                                    )}
                                    {project.data.description && (
                                        <p class="project-description">
                                            {project.data.description}
                                        </p>
                                    )}
                                </a>
                            </li>
                        );
                    })}
                </ul>
            </>
        )
    }
</Layout>

<script>
    const list = document.querySelector<HTMLElement>("[data-project-list]");
    const bar = document.querySelector<HTMLElement>("[data-sort-bar]");
    const control = document.querySelector<HTMLSelectElement>(
        "[data-sort-control]",
    );
    const status = document.querySelector<HTMLElement>("[data-sort-status]");

    if (list && bar && control) {
        const items = Array.from(list.children) as HTMLElement[];
        const key = (el: HTMLElement, name: string) =>
            Number(el.dataset[name] ?? 0);

        // Every comparator falls back to `order` so ties resolve to the
        // hand-curated sequence instead of whatever order the DOM happened
        // to be in — Array.prototype.sort is stable, but relying on that
        // across two different upstream sorts is fragile.
        const comparators: Record<
            string,
            (a: HTMLElement, b: HTMLElement) => number
        > = {
            relevance: (a, b) => key(a, "order") - key(b, "order"),
            newest: (a, b) =>
                key(b, "end") - key(a, "end") ||
                key(b, "start") - key(a, "start") ||
                key(a, "order") - key(b, "order"),
            oldest: (a, b) =>
                key(a, "start") - key(b, "start") ||
                key(a, "end") - key(b, "end") ||
                key(a, "order") - key(b, "order"),
        };

        const labels: Record<string, string> = {
            relevance: "Relevance",
            newest: "Date, newest first",
            oldest: "Date, oldest first",
        };

        function apply(name: string, announce: boolean) {
            const compare = comparators[name] ?? comparators.relevance;
            // Re-append the real nodes rather than shuffling CSS `order`, so
            // DOM order stays identical to visual order — tab sequence and
            // screen-reader traversal follow what's on screen.
            const fragment = document.createDocumentFragment();
            for (const item of items.slice().sort(compare)) {
                fragment.appendChild(item);
            }
            list!.appendChild(fragment);

            if (announce && status) {
                status.textContent = `Projects sorted by ${labels[name] ?? name}.`;
            }
        }

        // Honor ?sort= on load so a chosen order is linkable and survives
        // the back button.
        const requested = new URLSearchParams(location.search).get("sort");
        const initial =
            requested && requested in comparators ? requested : "relevance";
        control.value = initial;
        if (initial !== "relevance") apply(initial, false);

        control.addEventListener("change", () => {
            const next = control.value;
            apply(next, true);

            const url = new URL(location.href);
            if (next === "relevance") {
                url.searchParams.delete("sort");
            } else {
                url.searchParams.set("sort", next);
            }
            history.replaceState(null, "", url);
        });

        bar.hidden = false;
    }
</script>

<style>
    .lede {
        margin: 0 0 2rem;
        color: var(--color-text-muted);
        font-size: 1.05rem;
        max-width: var(--prose-width);
    }

    .sort-bar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem 0.75rem;
        margin: 0 0 0.5rem;
        font-size: 0.9rem;
    }

    .sort-bar label {
        color: var(--color-text-muted);
    }

    .sort-bar select {
        min-height: 44px;
        padding: 0 0.625rem;
        font: inherit;
        color: var(--color-text);
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 0.375rem;
    }

    .project-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
    }

    /* Hairline rules instead of bare gaps — with seven entries and no
       dividers the rows blurred into one another. */
    .project-item {
        border-top: 1px solid var(--color-border);
    }

    .project-item:last-child {
        border-bottom: 1px solid var(--color-border);
    }

    /* Two-column grid: title on the left, dateLabel right-aligned on the
       same baseline. Description (when present) tucks under the title in
       the left column on a second row. */
    .project-link {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        column-gap: 1.5rem;
        align-items: baseline;
        color: inherit;
        text-decoration: none;
        /* Padding lives on the link so the whole row is the hit area. */
        padding: 1rem 0;
    }

    .project-link:hover {
        background: var(--color-surface);
    }

    .project-title {
        grid-column: 1;
        grid-row: 1;
        margin: 0;
        /* Bumped from 1.05rem — titles were barely distinguishable from the
           0.9rem descriptions on the page that carries the portfolio. */
        font-size: 1.15rem;
        font-weight: 600;
        line-height: 1.35;
        color: var(--color-link);
    }

    .project-meta {
        grid-column: 2;
        grid-row: 1;
        color: var(--color-text-muted);
        font-size: 0.85rem;
        /* Keep dates on one line — they're always short ("Ongoing",
           "2026–present"), so wrapping would be visual noise. */
        white-space: nowrap;
    }

    .project-description {
        grid-column: 1;
        grid-row: 2;
        margin: 0.25rem 0 0;
        color: var(--color-text-muted);
        font-size: 0.9rem;
        line-height: 1.5;
        max-width: var(--prose-width);
    }

    .project-link:hover .project-title {
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .external-icon {
        font-weight: 400;
        font-size: 0.85em;
        opacity: 0.7;
    }
</style>
