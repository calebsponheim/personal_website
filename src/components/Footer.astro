---
const year = new Date().getFullYear();
---

<footer class="site-footer">
    <p>© {year} Caleb Sponheim</p>
</footer>

<style>
    .site-footer {
        max-width: var(--content-width);
        margin: 4rem auto 0;
        padding: 1.5rem;
        border-top: 1px solid var(--color-border);
        color: var(--color-text-muted);
        font-size: 0.875rem;
    }

    .site-footer p {
        margin: 0;
    }
</style>
