---
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
    { href: "/", label: "Home" },
    { href: "/about", label: "About" },
    { href: "/projects", label: "Projects" },
    { href: "/blog", label: "Blog" },
];
---

<nav class="primary-nav" aria-label="Primary">
    {
        links.map(({ href, label }) => (
            <a
                href={href}
                aria-current={currentPath === href ? "page" : undefined}
            >
                {label}
            </a>
        ))
    }
</nav>

<style>
    .primary-nav {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .primary-nav a {
        color: var(--color-text);
        text-decoration: none;
        font-size: 0.95rem;
        /* Pad the link out to a 44px-tall touch target without changing
           its visual size. The negative inline margin cancels the extra
           horizontal padding so the 1.5rem gap still reads as 1.5rem. */
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 0 0.375rem;
        margin: 0 -0.375rem;
    }

    .primary-nav a:hover {
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .primary-nav a[aria-current="page"] {
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 4px;
    }
</style>
