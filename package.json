{
  "name": "personal-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "pw:codegen": "playwright codegen http://localhost:4321",
    "deploy": "npm run check && npm run build && wrangler deploy",
    "cf:login": "wrangler login",
    "check": "astro check",
    "preview:worker": "wrangler dev --local --ip 127.0.0.1 --port 4321",
    "test:e2e:dev": "SITE_TEST_MODE=dev playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.4.1",
    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "^0.42.0",
    "sharp": "^0.35.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.62.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0"
  },
  "packageManager": "npm@10.9.9"
}
