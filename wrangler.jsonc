{
    "$schema": "./node_modules/wrangler/config-schema.json",

    // Worker name shown in the Cloudflare dashboard and in the workers.dev URL.
    "name": "calebsponheim-website",

    // Pin runtime behavior to a specific date. Bump periodically (see
    // https://developers.cloudflare.com/workers/configuration/compatibility-dates/)
    // — nothing here depends on flags newer than this, so it's safe to move forward.
    "compatibility_date": "2026-07-19",

    // Fully static build (astro build -> dist/, no SSR): a static-assets Worker
    // needs no `main` entrypoint at all. The Assets Worker serves files directly;
    // a user Worker script only runs if present and no asset matches the request.
    "assets": {
        "directory": "./dist",

        // This repo ships a custom src/pages/404.astro that Astro builds into
        // dist/404.html — serve it for unmatched paths instead of a generic 404.
        "not_found_handling": "404-page"
    }
}
